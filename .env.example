# ─────────────────────────────────────────────────────────────────────────────
# OrgaVents UI Handoff — Environment Variables Example
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# DUAL-MODE SWITCH
# ─────────────────
# true  → Mock Mode:  all API calls go to mockBackend.js (no server needed).
#          Perfect for UI/UX demos and frontend development.
# false → Live Mode:  all API calls go to VITE_API_URL with Bearer token.
#          Use this when your backend team's server is running.
VITE_USE_MOCK=true

# Live backend base URL (only active when VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:5000/api

# Legacy alias — kept for backward compatibility
VITE_API_BASE_URL=http://localhost:5000/api

# ─────────────────────────────────────────────────────────────────────────────
# SERVER (Express API — read by server/server.js, never exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/orgavents
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
